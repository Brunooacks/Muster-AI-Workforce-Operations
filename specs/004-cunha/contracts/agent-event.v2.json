{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muster:agent-event:v2",
  "title": "AgentEventInput v2",
  "description": "Corpo de POST /agents/{agentId}/events depois da cunha (C1.3). Todo campo novo é opcional: o corpo v1 continua válido e tem a mesma resposta. Conta, projeto e ambiente vêm da credencial; campos de tenant no corpo são ignorados. Regras que o JSON Schema não expressa e a API cobra com 422: attempt > 1 exige retryOf = run da mesma task com attempt anterior; runId/attempt/retryOf exigem taskId; acceptedByKind=auto exige acceptedRuleVersion; human_review exige taskId e success (decisão).",
  "type": "object",
  "properties": {
    "environment": { "type": "string", "enum": ["sandbox", "prod"] },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": { "type": "string", "enum": ["execution", "error", "escalation", "feedback", "heartbeat", "human_review"] },
    "ts": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number" },
    "costCents": { "type": "number" },
    "tokensIn": { "type": "number" },
    "tokensOut": { "type": "number" },
    "success": { "type": "boolean", "description": "Em human_review: true = aprovado, false = rejeitado." },
    "metadata": { "type": "object", "additionalProperties": true },

    "taskId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "x-veltrix-task" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200, "description": "x-veltrix-run" },
    "attempt": { "type": "integer", "minimum": 1, "description": "Ordinal do run dentro da task; sem valor = 1 (ou anterior + 1 quando há retryOf)." },
    "retryOf": { "type": "string", "minLength": 1, "maxLength": 200, "description": "runId da tentativa anterior da mesma task." },
    "expected": { "description": "Resultado esperado (camada 2)." },
    "actual": { "description": "Resultado obtido (camada 2)." },
    "acceptedBy": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Quem decidiu: pessoa (human) ou regra (auto)." },
    "acceptedByKind": { "type": "string", "enum": ["human", "auto"] },
    "acceptedRuleVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "object",
      "properties": {
        "tools": { "type": "boolean" },
        "vision": { "type": "boolean" },
        "contextWindow": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "reworkCount": { "type": "integer", "minimum": 0 },
    "humanMinutes": { "type": "number", "minimum": 0, "maximum": 999999.99 },
    "contextTokens": { "type": "integer", "minimum": 0 },
    "model": { "type": "string", "minLength": 1, "maxLength": 200 }
  },
  "additionalProperties": true
}
