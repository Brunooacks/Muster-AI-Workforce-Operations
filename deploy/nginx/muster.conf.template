# This is the production vhost template. Do not enable it for private staging.
# Render MUSTER_SERVER_NAME with envsubst before placing it in nginx/conf.d.

limit_req_zone $binary_remote_addr zone=muster_api:10m rate=10r/s;

server {
  listen 80;
  listen [::]:80;
  server_name ${MUSTER_SERVER_NAME};

  client_max_body_size 1m;

  location = /api/telemetry/activity/stream {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Request-Id $request_id always;
  }

  location ~ ^/api/(agents|integrations)/ {
    limit_req zone=muster_api burst=20 nodelay;
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Request-Id $request_id always;
  }

  location / {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Request-Id $request_id always;
  }
}
