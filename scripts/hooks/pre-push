#!/usr/bin/env bash
# Hook pre-push do Muster (instale com `make hooks`).
# Roda o name-gate sobre os commits enviados: linhas adicionadas, mensagem e
# autor/committer. A lista vem de ~/.config/muster/blocklist (ou das variáveis
# MUSTER_BLOCKLIST / MUSTER_BLOCKLIST_FILE). Sem lista, o push é recusado.
# MUSTER_PREPUSH_FULL=1 também roda `make ci` antes de enviar.
set -euo pipefail

remote_name="${1:-origin}"
repo_root="$(git rev-parse --show-toplevel)"
gate="$repo_root/scripts/ci/name-gate.sh"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${local_sha:-}" ]] || continue
  # Remoção de branch: nada a enviar.
  [[ "$local_sha" =~ ^0+$ ]] && continue

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # Branch nova: só os commits que o remoto ainda não conhece.
    rev_args=("$local_sha" --not "--remotes=$remote_name")
  else
    rev_args=("$local_sha" "^$remote_sha")
  fi

  if [[ -z "$(git rev-list "${rev_args[@]}" | head -n 1)" ]]; then
    continue
  fi

  echo "pre-push: name-gate em $local_ref → $remote_ref"
  rc=0
  bash "$gate" --commits "${rev_args[@]}" < /dev/null || rc=$?
  if ((rc == 3)); then
    echo 'pre-push: push recusado: lista de bloqueio ausente (crie ~/.config/muster/blocklist).' >&2
    exit 1
  fi
  ((rc == 0)) || status=1
done

if ((status != 0)); then
  cat >&2 <<'EOF'
pre-push: push recusado pelo name-gate. Remova o termo dos arquivos/commits
listados acima (git commit --amend ou git rebase) e tente de novo.
EOF
  exit 1
fi

if [[ "${MUSTER_PREPUSH_FULL:-}" == "1" ]]; then
  echo "pre-push: MUSTER_PREPUSH_FULL=1, rodando make ci"
  make -C "$repo_root" ci
fi
