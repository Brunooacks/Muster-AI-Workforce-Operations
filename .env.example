# ============================================================================
# Cohort — Environment variables
# ============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================


# ----------------------------------------------------------------------------
# Core (always required)
# ----------------------------------------------------------------------------

# Postgres connection string. Locally, a docker Postgres or Neon/Supabase URL.
# Example: postgresql://user:password@host:5432/cohort?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cohort

# Port the API server listens on. Required — the server refuses to boot without it.
PORT=8080

# development | production
NODE_ENV=development

# pino log level: trace|debug|info|warn|error|fatal (default: info)
LOG_LEVEL=info


# Demo data remains opt-in; authentication is always provided by Clerk.
ALLOW_SEEDED_EVALUATIONS=false

# Where the Vite dev server proxies /api requests (local API server).
API_PROXY_TARGET=http://localhost:8080
WEB_APP_URL=http://localhost:5173
# Comma-separated extra browser origins. Localhost:5173 and 127.0.0.1:5173
# are added automatically only when NODE_ENV=development.
CORS_ALLOWED_ORIGINS=


# ----------------------------------------------------------------------------
# Continuous telemetry / transactional outbox
# ----------------------------------------------------------------------------
# Enabled by default. Set false only when this API process must not consume the
# queue (for example, an API-only replica with dedicated worker replicas).
CONTINUOUS_TELEMETRY_WORKER_ENABLED=true
# Target freshness: polling 1s + event debounce (0s error/escalation, 1s
# feedback, 5s execution). Tune conservatively according to database capacity.
CONTINUOUS_TELEMETRY_POLL_MS=1000
CONTINUOUS_TELEMETRY_BATCH_SIZE=20
CONTINUOUS_TELEMETRY_MAX_ATTEMPTS=5
CONTINUOUS_TELEMETRY_RETRY_BASE_MS=1000
CONTINUOUS_TELEMETRY_RETRY_MAX_MS=300000
# Reclaims processing rows left behind by a crashed instance.
CONTINUOUS_TELEMETRY_PROCESSING_TIMEOUT_MS=60000

# Single-container release image only. Keep false for local development and
# multi-replica deployments that run migrations in a separate release phase.
MIGRATE_ON_START=false
DB_MIGRATIONS_DIR=migrations

# Optional: when set, the API serves the built Vite SPA and SPA fallbacks.
# The production Docker image configures /app/public automatically.
WEB_STATIC_DIR=


# ----------------------------------------------------------------------------
# Auth — Clerk  (API server)
# ----------------------------------------------------------------------------
# Create a Clerk project at https://dashboard.clerk.com and paste its keys here.

# Backend secret key (sk_test_... / sk_live_...).
CLERK_SECRET_KEY=

# Publishable key fallback used when the host cannot be derived (pk_test_.../pk_live_...).
CLERK_PUBLISHABLE_KEY=


# ----------------------------------------------------------------------------
# Auth — Clerk  (frontend / Vite build)
# ----------------------------------------------------------------------------
# These are baked into the frontend bundle at BUILD time (must be present when
# running `pnpm --filter @workspace/cohort run build`).

# Frontend publishable key (pk_test_... / pk_live_...). Required by the SPA.
VITE_CLERK_PUBLISHABLE_KEY=

# Restricts public registration to Clerk invitations/allowlists. The API and
# SPA flags are intentionally separate because the SPA value is embedded at build time.
# Fail closed: unset, empty or any value other than `false` means invite-only.
# Local tooling that needs open sign-up must set both to `false` explicitly.
MUSTER_INVITE_ONLY=true
VITE_MUSTER_INVITE_ONLY=true
# Optional contact link rendered on the landing page in invitation-only mode.
# Leave blank when no contact channel should be published.
VITE_MUSTER_CONTACT_URL=

# ----------------------------------------------------------------------------
# OpenAI integration  (agent source analysis — analyze.ts)
# ----------------------------------------------------------------------------
# Point these at the real OpenAI API or an OpenAI-compatible gateway.

# https://api.openai.com/v1  (or your gateway base URL)
# Anthropic também funciona via endpoint OpenAI-compatible:
#   AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.anthropic.com/v1/
#   AI_INTEGRATIONS_OPENAI_API_KEY=sk-ant-...
#   AI_INTEGRATIONS_OPENAI_MODEL=claude-sonnet-5
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# sk-...  (your OpenAI API key)
AI_INTEGRATIONS_OPENAI_API_KEY=

# Chat model used for agent source analysis (default: gpt-5.4)
AI_INTEGRATIONS_OPENAI_MODEL=


# ----------------------------------------------------------------------------
# GitHub — private repo import (optional)
# ----------------------------------------------------------------------------
# Only needed to import agents from PRIVATE GitHub repos. Public repos work
# without it. A fine-grained PAT with `contents: read` is enough.
# GITHUB_TOKEN / GH_TOKEN / GITHUB_ACCESS_TOKEN are all accepted (first wins).
GITHUB_TOKEN=


# ----------------------------------------------------------------------------
# Connector credentials at rest (required when persisting a connector secret)
# ----------------------------------------------------------------------------
# Exactly 32 random bytes encoded as base64 (recommended) or 64 hexadecimal
# characters. Generate with: openssl rand -base64 32
# Keep the same value across API replicas. Never commit the real key.
MUSTER_CREDENTIAL_ENCRYPTION_KEY=

# One-time compatibility switch. Keep false normally. Set true only while
# intentionally migrating legacy plaintext connector credentials on next use,
# verify the migration, then immediately restore false.
MUSTER_ALLOW_LEGACY_CREDENTIAL_MIGRATION=false


# ----------------------------------------------------------------------------
# Running agent locally or in Docker (optional MVP validation)
# ----------------------------------------------------------------------------
# API origin reachable by the runner. In Docker, host.docker.internal is used
# by docker-compose; override this when the API runs in another container.
MUSTER_BASE_URL=http://localhost:8080
MUSTER_AGENT_ID=
MUSTER_AGENT_MODEL=gpt-4o-mini
# dry-run validates runner + tools + telemetry without an LLM key; live calls
# the configured OpenAI-compatible endpoint.
AGENT_MODE=dry-run
AGENT_TASK=Analise a saúde operacional de um agente de suporte, proponha uma próxima ação e registre a decisão.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MUSTER_AUTH_TOKEN=
MUSTER_EXECUTION_BACKEND=local
MUSTER_WORKSPACE=
# Host path mounted as /workspace by docker-compose agent profiles.
MUSTER_WORKSPACE_PATH=.
MUSTER_TASK_TIMEOUT_MS=120000
# Required only for the explicit agent-docker profile; do not expose the
# Docker socket unless this runner is trusted and its task catalog is reviewed.
MUSTER_DOCKER_CONTAINER=
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Provider-neutral worker endpoint for cloud or on-prem execution.
MUSTER_EXECUTION_GATEWAY_URL=
MUSTER_EXECUTION_TOKEN=


# ----------------------------------------------------------------------------
# Playwright / Gauntlet browser validation
# ----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
# Dedicated Clerk identity and tenant created/reused by the E2E setup.
# Use only a test Clerk instance: the setup resets the agents in this tenant.
E2E_CLERK_USER_EMAIL=muster.gauntlet+clerk_test@example.com
E2E_CLERK_ORG_NAME=Muster Gauntlet E2E
# Set true only when the frontend is already running outside Playwright.
PLAYWRIGHT_SKIP_WEBSERVER=false
